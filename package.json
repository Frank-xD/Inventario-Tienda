{
  "name": "inventario-tienda",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@12.18.0",
  "scripts": {
    "dev:frontend": "pnpm --filter frontend dev",
    "dev:backend": "pnpm --filter backend start:dev",
    "build:frontend": "pnpm --filter frontend build",
    "build:backend": "pnpm --filter backend build",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "test": "pnpm --filter backend test",
    "db:up": "docker compose up -d database",
    "db:migrate": "pnpm --filter backend prisma:migrate",
    "db:seed": "pnpm --filter backend db:seed",
    "db:studio": "pnpm --filter backend prisma:studio",
    "docker:up": "docker compose up --build",
    "docker:down": "docker compose down",
    "docker:prod": "docker compose -f docker-compose.yml -f docker-compose.prod.yml up --build -d"
  }
}
