# Copia este archivo a .env y ajusta los valores.

# ---- Base de datos (PostgreSQL) ----
POSTGRES_USER=tienda
POSTGRES_PASSWORD=password
POSTGRES_DB=tienda_db
POSTGRES_PORT=5432

# ---- Backend (NestJS) ----
BACKEND_PORT=3001
CORS_ORIGIN=http://localhost:3000
# NestJS Observe (opcional): https://observe.nestjs.com
OBSERVE_APP_KEY=
OBSERVE_APP_SECRET=

# ---- Frontend (Next.js) ----
FRONTEND_PORT=3000
# URL del backend tal como la ve el NAVEGADOR
NEXT_PUBLIC_API_URL=http://localhost:3001
